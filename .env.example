# Copy this file to ".env" (same folder as README.md). Never commit .env.
# Everything here is OPTIONAL - DevGuard works without any of it.

# AI features (same variable names as NutrAI, so you can reuse your key)
# Get a free key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Optional: raises GitHub's anonymous limit (60 requests/hour) if you import many repos
GITHUB_TOKEN=
