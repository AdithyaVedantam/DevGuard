# Copy to ".env" (same folder as README.md). Never commit .env. Everything is OPTIONAL.

# --- AI (Gemini). Get a key at https://aistudio.google.com/apikey ---
LLM_API_KEY=
# Tried first. Google retires gemini-2.5-* on 2026-10-16, so use a newer model.
LLM_MODEL=gemini-3.1-flash-lite
# Tried in order if the first fails (rate limit, retired model, outage). Comma-separated.
LLM_FALLBACK_MODELS=gemini-3-flash-preview,gemini-3.5-flash,gemini-2.5-flash-lite

# --- Optional second AI provider (any OpenAI-compatible API: xAI Grok, Groq, OpenRouter, ...) ---
# Used only after every Gemini model failed. Example for xAI:
#   ALT_BASE_URL=https://api.x.ai/v1   ALT_MODELS=grok-4.3   (xAI's API is paid; check console.x.ai)
ALT_API_KEY=
ALT_BASE_URL=
ALT_MODELS=

# --- GitHub (raises the anonymous 60 requests/hour limit) ---
GITHUB_TOKEN=

# --- Hosted site only: set to 1 on Render. Hides API docs, disables delete, rate-limits. ---
DEVGUARD_PUBLIC=
